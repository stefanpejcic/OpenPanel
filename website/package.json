    "yaml": "2.8.3",
    "schema-utils@3.1.1": {
      "ajv": "6.14.0"
    },
    "schema-utils@4.3.3": {
      "ajv": "8.18.0"
    },
    "webpack-bundle-analyzer": {
      "ws": "7.5.11"
    }
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
