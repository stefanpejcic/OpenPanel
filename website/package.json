{
  "name": "documentation",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "dev:lean": "DISABLE_VERSIONING=true DISABLE_EXAMPLES=true npm run start",
    "dev:docs": "DISABLE_BLOG=true npm run dev:lean",
    "dev:blog": "DISABLE_DOCS=true npm run dev:lean",
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" docusaurus build",
    "build:plugins": "sucrase ./plugins -d ./plugins --transforms typescript,imports && npx prettier --write ./plugins",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@headlessui/react": "^1.7.15",
    "@mdx-js/react": "^3.0.0",
    "@swc/core": "^1.15.47",
    "@tailwindcss/line-clamp": "^0.4.2",
    "autoprefixer": "^10.4.8",
    "clsx": "^1.2.1",
    "copy-text-to-clipboard": "^3.1.0",
    "dedent": "^0.7.0",
    "docusaurus-plugin-copy-page-button": "^0.8.4",
    "docusaurus-plugin-generate-llms-txt": "0.0.1",
    "dotenv": "^16.0.2",
    "framer-motion": "^6.5.1",
    "postcss": "^8.4.16",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.11.0",
    "react-markdown": "^8.0.3",
    "react-share": "^4.4.0",
    "swc-loader": "^0.2.7",
    "tailwindcss": "^3.3.5",
    "title-case": "^3.0.3"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "braces": "3.0.3",
    "cross-spawn": "7.0.5",
    "diff": "5.2.2",
    "follow-redirects": "1.16.0",
    "js-yaml": "4.3.1",
    "loader-utils": "2.0.4",
    "lodash": "4.18.1",
    "micromatch": "4.0.8",
    "nanoid": "3.3.17",
    "path-to-regexp": "1.9.0",
    "picomatch": "2.3.2",
    "serialize-javascript": "7.0.5",
    "undici": "7.29.0",
    "uuid": "11.1.1",
